# Copia este archivo a .env y cambia todos los valores de ejemplo por secretos propios.

# Credenciales de MariaDB. No publiques estos puertos en Internet.
MYSQL_DATABASE=whatsapp_tasks
MYSQL_USER=whatsapp_app
MYSQL_PASSWORD=cambia-esta-clave-de-base-de-datos
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root-larga

# Credenciales de Gmail. No publiques estos puertos en Internet. Cambia esta contraseña por una larga y segura.
GMAIL_USER=usuario-correo
GMAIL_PASS=cambia-esta-clave-de-gmail

# Usuario administrador de la base de tareas para phpMyAdmin.
# Usa letras, números, guiones o guiones bajos; cambia esta contraseña.
MYSQLADMIN_USER=whatsapp_lector
MYSQLADMIN_PASSWORD=cambia-esta-clave-phpmyadmin

# Secreto que también se configura en Meta > Webhook > Verify token.
WHATSAPP_VERIFY_TOKEN=cambia-este-token-por-una-cadena-larga

# App Secret de Meta: recomendado para validar la firma del webhook.
WHATSAPP_APP_SECRET=

# Acceso para el televisor y el equipo. Limita el puerto 8080 a tu red local
# en el firewall y no lo publiques directamente en Internet.
HOST_BIND=0.0.0.0
HOST_PORT=8080

# Refresca el dashboard cuando guardes cambios en el código fuente.
DEV_LIVE_RELOAD=true

# Servicio exclusivo del webhook de WhatsApp. Mantén localhost si el proxy
# HTTPS se ejecuta en este ordenador y reenvía GET y POST de /webhook aquí.
# Si el proxy corre en otro contenedor, consulta las instrucciones del README
# antes de cambiar WEBHOOK_HOST_BIND; no publiques este puerto directamente.
WEBHOOK_HOST_BIND=0.0.0.0
WEBHOOK_HOST_PORT=8081

# phpMyAdmin para revisar MariaDB desde este ordenador. Mantenlo en localhost
# y usa las credenciales de MariaDB en su pantalla de inicio de sesión.
MYSQLADMIN_HOST_BIND=0.0.0.0
MYSQLADMIN_HOST_PORT=8082

# Filtros de correo (separados por comas, sin espacios entre elementos)
EXCLUDED_SENDERS=noreply@google.com
ALLOWED_RECIPIENTS=correo@gmail.com
EMAIL_LOOKBACK_HOURS=3