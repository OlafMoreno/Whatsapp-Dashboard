# Copia este archivo a .env y cambia todos los valores de ejemplo por secretos propios.

# Credenciales del dashboard privado.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=cambia-esta-clave-por-una-larga

# Credenciales de MariaDB. No publiques estos puertos en Internet.
MYSQL_DATABASE=whatsapp_tasks
MYSQL_USER=whatsapp_app
MYSQL_PASSWORD=cambia-esta-clave-de-base-de-datos
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root-larga

# Secreto que también se configura en Meta > Webhook > Verify token.
WHATSAPP_VERIFY_TOKEN=cambia-este-token-por-una-cadena-larga

# App Secret de Meta: recomendado para validar la firma del webhook.
WHATSAPP_APP_SECRET=

# Solo son necesarios si quieres enviar respuestas automáticas.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v26.0
REPLY_ON_RECEIVE=false
NOTIFY_ON_DONE=false

# Acceso para el televisor y el equipo. Limita el puerto 8080 a tu red local
# en el firewall y no lo publiques directamente en Internet.
HOST_BIND=0.0.0.0
HOST_PORT=8080

# Refresca el dashboard cuando guardes cambios en el código fuente.
DEV_LIVE_RELOAD=true

# Servicio exclusivo del webhook de WhatsApp. Por defecto solo acepta
# conexiones desde este ordenador; una pasarela HTTPS local puede reenviar
# únicamente /webhook a este puerto.
WEBHOOK_HOST_BIND=127.0.0.1
WEBHOOK_HOST_PORT=8081
